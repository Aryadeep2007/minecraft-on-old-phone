# Copy to .env on the phone and replace every placeholder with a unique secret.
# Generate each value on the phone; do not commit .env.
FLASK_SECRET_KEY=<GENERATE_RANDOM_SESSION_SECRET>
DASHBOARD_PASSWORD=<SET_A_LONG_UNIQUE_PASSWORD>
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=<SET_A_DIFFERENT_LONG_RCON_PASSWORD>
MINECRAFT_SERVER_DIR=/data/data/com.termux/files/home/minecraft-server
BACKUP_DIR=/data/data/com.termux/files/home/minecraft-backups
